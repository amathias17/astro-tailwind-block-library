---
import BaseLayout from '../layouts/BaseLayout.astro';
import { blockCategories } from '../data/blockCategories';

const reviewedVariantTotal = blockCategories.reduce((total, category) => total + (category.count ?? 0), 0);
const accentStyles: Record<string, string> = {
  sky: 'bg-sky-100 text-sky-800 ring-sky-200',
  violet: 'bg-violet-100 text-violet-800 ring-violet-200',
  amber: 'bg-amber-100 text-amber-800 ring-amber-200',
  emerald: 'bg-emerald-100 text-emerald-800 ring-emerald-200',
  rose: 'bg-rose-100 text-rose-800 ring-rose-200',
  orange: 'bg-orange-100 text-orange-800 ring-orange-200',
  cyan: 'bg-cyan-100 text-cyan-800 ring-cyan-200',
  lime: 'bg-lime-100 text-lime-800 ring-lime-200',
  pink: 'bg-pink-100 text-pink-800 ring-pink-200',
  indigo: 'bg-indigo-100 text-indigo-800 ring-indigo-200',
  teal: 'bg-teal-100 text-teal-800 ring-teal-200',
  slate: 'bg-slate-200 text-slate-800 ring-slate-300',
  blue: 'bg-blue-100 text-blue-800 ring-blue-200',
  fuchsia: 'bg-fuchsia-100 text-fuchsia-800 ring-fuchsia-200',
  yellow: 'bg-yellow-100 text-yellow-800 ring-yellow-200',
  green: 'bg-green-100 text-green-800 ring-green-200',
  red: 'bg-red-100 text-red-800 ring-red-200',
  gray: 'bg-gray-200 text-gray-800 ring-gray-300',
};
---
<BaseLayout
  title="Astro + Tailwind Block Library"
  description="A structured library of Astro and Tailwind website blocks."
>
  <main>
    <section class="relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(14,165,233,0.22),transparent_34%),radial-gradient(circle_at_20%_90%,rgba(168,85,247,0.18),transparent_32%)]"></div>
      <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-20 lg:px-8 lg:pb-28 lg:pt-28">
        <div class="max-w-4xl">
          <p class="mb-6 text-xs font-semibold uppercase tracking-[0.28em] text-sky-300">Astro + Tailwind structural library</p>
          <h1 class="max-w-4xl font-display text-5xl leading-[0.98] tracking-tight sm:text-7xl">Start with structure. Make it yours.</h1>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-300">
            A growing catalogue of Tailwind 4 structures for Astro projects. Choose the right composition first, then apply the content, visual direction and interaction that make the site specific.
          </p>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-400">
          <span><strong class="text-white">{blockCategories.length}</strong> block families</span>
          <span><strong class="text-white">{reviewedVariantTotal}</strong> reviewed variants</span>
          <span>Astro only</span>
          <span>Tailwind 4</span>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-14 lg:px-8 lg:py-20" aria-labelledby="categories-heading">
      <div class="mb-10 flex flex-col justify-between gap-5 border-b border-slate-300 pb-7 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Browse the library</p>
          <h2 id="categories-heading" class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Choose a starting point</h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-slate-600">These are structural starting points, not finished designs. The design pass comes after the composition earns its place.</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {blockCategories.map((category, index) => {
          const classes = accentStyles[category.accent];
          const card = (
            <div class="group flex min-h-56 flex-col justify-between p-6">
              <div class="flex items-start justify-between gap-4">
                <span class={`inline-flex h-11 w-11 items-center justify-center rounded-full text-sm font-semibold ring-1 ${classes}`}>{String(index + 1).padStart(2, '0')}</span>
                {category.count ? <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">{category.count} variants</span> : <span class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Coming next</span>}
              </div>
              <div>
                <h3 class="text-2xl font-semibold tracking-tight text-slate-950 transition group-hover:text-sky-700">{category.label}</h3>
                <p class="mt-2 max-w-xs text-sm leading-6 text-slate-600">{category.description}</p>
                <span class="mt-5 inline-block text-sm font-semibold text-slate-500 group-hover:text-slate-950">{category.href ? 'Open catalogue →' : 'Being assembled'}</span>
              </div>
            </div>
          );

          return category.href ? (
            <a href={category.href} class="overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-400 hover:shadow-xl">{card}</a>
          ) : (
            <div class="overflow-hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50">{card}</div>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
