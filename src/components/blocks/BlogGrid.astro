---
import Container from '../primitives/Container.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import type { BlogPost } from './types';
interface Props { title: string; description?: string; posts: BlogPost[] }
const { title, description, posts } = Astro.props;
---
<section class="bg-surface py-section">
  <Container>
    <SectionHeading title={title} description={description} />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((post) => <article class="overflow-hidden border border-border bg-surface">
        <img src={post.image} alt={post.imageAlt} width="900" height="600" loading="lazy" class="h-52 w-full object-cover" />
        <div class="p-6"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand">{post.date}</p><h3 class="mt-3 text-xl font-semibold text-ink">{post.title}</h3><p class="mt-3 leading-7 text-body">{post.excerpt}</p>{post.href && <a href={post.href} class="mt-5 inline-block font-semibold text-brand-strong hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">Read article →</a>}</div>
      </article>)}
    </div>
  </Container>
</section>
