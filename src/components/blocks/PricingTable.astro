---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
interface Plan { name: string; price: string; description: string; features: string[]; featured?: boolean }
interface Props { title: string; description?: string; plans: Plan[] }
const { title, description, plans } = Astro.props;
---
<section class="bg-slate-50 py-20"><Container><div class="mx-auto max-w-2xl text-center"><h2 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">{title}</h2>{description && <p class="mt-4 leading-7 text-slate-600">{description}</p>}</div><div class="mt-10 grid gap-6 md:grid-cols-3">{plans.map((plan) => <article class={`border bg-white p-8 ${plan.featured ? 'border-blue-600 shadow-xl md:-my-4' : 'border-slate-200'}`}><p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600">{plan.name}</p><p class="mt-4 text-5xl font-bold text-slate-950">{plan.price}</p><p class="mt-3 text-slate-600">{plan.description}</p><ul class="my-7 space-y-3 text-sm text-slate-600">{plan.features.map((feature) => <li>✓ {feature}</li>)}</ul><Button label="Choose plan" href="#" kind={plan.featured ? 'primary' : 'secondary'} /></article>)}</div></Container></section>
