---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import type { PricingPlan } from './types';
interface Props { title: string; description?: string; plans: PricingPlan[] }
const { title, description, plans } = Astro.props;
---
<section class="bg-surface-muted py-section">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
      {description && <p class="mt-4 leading-7 text-body">{description}</p>}
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {plans.map((plan) => <article class={`border bg-surface p-8 ${plan.featured ? 'border-brand shadow-xl md:-my-4' : 'border-border'}`}>
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">{plan.name}</h3>
        <p class="mt-4 text-5xl font-bold text-ink">{plan.price}</p>
        <p class="mt-3 text-body">{plan.description}</p>
        <ul class="my-7 space-y-3 text-sm text-body">{plan.features.map((feature) => <li>✓ {feature}</li>)}</ul>
        {plan.action && <Button label={plan.action.label} href={plan.action.href} kind={plan.featured ? 'primary' : 'secondary'} />}
      </article>)}
    </div>
  </Container>
</section>
