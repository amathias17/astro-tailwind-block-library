---
import Container from '../primitives/Container.astro';
interface Props { title: string; description?: string; action?: string }
const { title, description, action = '#' } = Astro.props;
---
<section class="bg-surface-muted py-section"><Container><div class="grid gap-10 lg:grid-cols-2 lg:items-start"><div><h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>{description && <p class="mt-5 max-w-xl leading-8 text-body">{description}</p>}</div><form action={action} method="post" class="rounded-ui bg-surface p-8 shadow-panel"><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-ink">Name<input name="name" required class="mt-2 w-full border border-border-strong p-3" /></label><label class="text-sm font-semibold text-ink">Email<input name="email" type="email" required class="mt-2 w-full border border-border-strong p-3" /></label></div><label class="mt-4 block text-sm font-semibold text-ink">Message<textarea name="message" required class="mt-2 min-h-36 w-full border border-border-strong p-3"></textarea></label><button type="submit" class="mt-5 bg-brand px-5 py-3 font-semibold text-on-dark hover:bg-brand-hover">Send message</button></form></div></Container></section>
