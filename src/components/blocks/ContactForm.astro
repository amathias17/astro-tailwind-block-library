---
import Container from '../primitives/Container.astro';
interface Props { title: string; description?: string; action?: string }
const { title, description, action = '#' } = Astro.props;
---
<section class="bg-slate-50 py-20"><Container><div class="grid gap-10 lg:grid-cols-2 lg:items-start"><div><h2 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">{title}</h2>{description && <p class="mt-5 max-w-xl leading-8 text-slate-600">{description}</p>}</div><form action={action} method="post" class="bg-white p-8 shadow-sm"><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-semibold text-slate-700">Name<input name="name" required class="mt-2 w-full border border-slate-300 p-3" /></label><label class="text-sm font-semibold text-slate-700">Email<input name="email" type="email" required class="mt-2 w-full border border-slate-300 p-3" /></label></div><label class="mt-4 block text-sm font-semibold text-slate-700">Message<textarea name="message" required class="mt-2 min-h-36 w-full border border-slate-300 p-3"></textarea></label><button type="submit" class="mt-5 bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700">Send message</button></form></div></Container></section>
