---
import Container from '../primitives/Container.astro';
interface Props { brand?: string; description?: string }
const { brand = 'Studio.', description = 'Making useful things for thoughtful people.' } = Astro.props;
---
<footer class="bg-slate-950 py-14 text-slate-300"><Container><div class="grid gap-8 md:grid-cols-3"><div><a href="/" class="text-2xl font-bold text-white">{brand}</a><p class="mt-4 max-w-xs leading-7">{description}</p></div><div><h2 class="font-semibold text-white">Explore</h2><ul class="mt-4 space-y-2"><li><a href="#" class="hover:text-white">About</a></li><li><a href="#" class="hover:text-white">Work</a></li><li><a href="#" class="hover:text-white">Contact</a></li></ul></div><div><h2 class="font-semibold text-white">Connect</h2><p class="mt-4">hello@example.com</p></div></div><div class="mt-12 border-t border-slate-800 pt-6 text-sm">© 2026 {brand} All rights reserved.</div></Container></footer>
