---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import type { LinkAction } from './types';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primary: LinkAction;
  secondary?: LinkAction;
  variant?: 'editorial' | 'centered';
}
const { eyebrow, title, description, primary, secondary, variant = 'editorial' } = Astro.props;
const centered = variant === 'centered';
---
<section class="relative isolate overflow-hidden bg-surface-dark py-20 text-on-dark sm:py-28 lg:py-36">
  <div aria-hidden="true" class="absolute -right-20 -top-36 h-96 w-96 rounded-full border border-on-dark/10 sm:h-[36rem] sm:w-[36rem]"></div>
  <div aria-hidden="true" class="absolute -right-36 top-28 h-96 w-96 rounded-full border border-brand/40 sm:h-[36rem] sm:w-[36rem]"></div>
  <div aria-hidden="true" class="absolute bottom-0 left-0 h-1 w-1/3 bg-brand"></div>
  <Container>
    <div class={centered ? 'relative mx-auto max-w-4xl text-center' : 'relative max-w-5xl'}>
      {eyebrow && <p class="mb-7 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-brand-soft"><span aria-hidden="true" class="h-px w-8 bg-brand"></span>{eyebrow}</p>}
      <h1 class="font-display text-5xl font-normal leading-[1.06] tracking-tight sm:text-7xl lg:text-8xl">{title}</h1>
      <p class={centered ? 'mx-auto mt-8 max-w-2xl text-lg leading-8 text-on-dark-muted' : 'mt-8 max-w-2xl text-lg leading-8 text-on-dark-muted'}>{description}</p>
      <div class={centered ? 'mt-10 flex flex-wrap justify-center gap-4' : 'mt-10 flex flex-wrap gap-4'}>
        <Button href={primary.href} label={primary.label} kind="light" />
        {secondary && <a href={secondary.href} class="inline-flex items-center rounded-ui border border-on-dark-muted px-5 py-3 font-semibold text-on-dark transition hover:border-on-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">{secondary.label} <span aria-hidden="true" class="ml-2">↗</span></a>}
      </div>
    </div>
  </Container>
</section>
