---
import Container from '../primitives/Container.astro';
interface Testimonial { quote: string; name: string; role: string }
interface Props { title: string; testimonials: Testimonial[]; tone?: 'light' | 'dark' }
const { title, testimonials, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<section class={`${dark ? 'bg-slate-950 text-white' : 'bg-slate-100 text-slate-950'} py-20`}><Container><h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{testimonials.map((item) => <blockquote class={`${dark ? 'bg-slate-900' : 'bg-white'} p-8`}><p class="text-xl leading-8">“{item.quote}”</p><footer class="mt-6"><strong class="block">{item.name}</strong><span class={dark ? 'text-slate-400' : 'text-slate-500'}>{item.role}</span></footer></blockquote>)}</div></Container></section>
