---
import Container from '../primitives/Container.astro';
import type { TestimonialItem } from './types';
interface Props { title: string; testimonials: TestimonialItem[]; tone?: 'light' | 'dark' }
const { title, testimonials, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<section class={`${dark ? 'bg-surface-dark text-on-dark' : 'bg-surface-subtle text-ink'} py-section`}><Container><h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{testimonials.map((item) => <blockquote class={`${dark ? 'bg-surface-dark-raised' : 'bg-surface'} p-8`}><p class="text-xl leading-8">“{item.quote}”</p><footer class="mt-6"><strong class="block">{item.name}</strong><span class={dark ? 'text-on-dark-muted' : 'text-body'}>{item.role}</span></footer></blockquote>)}</div></Container></section>
