---
import Container from '../primitives/Container.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
interface Feature { title: string; description: string; icon?: string }
interface Props { eyebrow?: string; title: string; description?: string; items: Feature[]; columns?: 2 | 3 | 4 }
const { eyebrow, title, description, items, columns = 3 } = Astro.props;
const grid = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[columns];
---
<section class="bg-white py-20">
  <Container>
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />
    <div class={`mt-10 grid gap-6 ${grid}`}>
      {items.map((item, index) => <article class="border border-slate-200 bg-slate-50 p-6">
        <div class="mb-5 flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">{item.icon ?? String(index + 1).padStart(2, '0')}</div>
        <h3 class="text-xl font-semibold text-slate-950">{item.title}</h3>
        <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
      </article>)}
    </div>
  </Container>
</section>
