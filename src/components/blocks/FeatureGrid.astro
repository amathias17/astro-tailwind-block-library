---
import Container from '../primitives/Container.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import type { FeatureItem } from './types';
interface Props { eyebrow?: string; title: string; description?: string; items: FeatureItem[]; columns?: 2 | 3 | 4 }
const { eyebrow, title, description, items, columns = 3 } = Astro.props;
const grid = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[columns];
---
<section class="bg-surface py-section">
  <Container>
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />
    <div class={`mt-10 grid gap-6 ${grid}`}>
      {items.map((item, index) => <article class="rounded-ui border border-border bg-surface-muted p-6">
        <div class="mb-5 flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-sm font-bold text-brand-strong">{item.icon ?? String(index + 1).padStart(2, '0')}</div>
        <h3 class="text-xl font-semibold text-ink">{item.title}</h3>
        <p class="mt-3 leading-7 text-body">{item.description}</p>
      </article>)}
    </div>
  </Container>
</section>
