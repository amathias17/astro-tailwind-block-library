---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'mx-auto text-center' : '';
---
<div class={`max-w-2xl ${alignment}`}>
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 leading-7 text-body">{description}</p>}
</div>
